# Copier en .env puis lancer `npm run setup` (crée et remplit les seeds Testnet + jetons aléatoires).
# NE JAMAIS COMMITER .env — Testnet uniquement, aucune seed Mainnet.
XRPL_WS_URLS=wss://testnet.xrpl-labs.com,wss://s.altnet.rippletest.net:51233,wss://testnet.honeycluster.io
ORG_SEED=
ALICE_SEED=
BOB_SEED=
# Laissés vides : `npm run setup` génère des jetons aléatoires (crypto.randomBytes).
# Le serveur refuse de démarrer si un jeton est vide, vaut `change-me…` ou fait moins de 16 caractères.
ADMIN_TOKEN=
GATE_TOKEN=
PORT=3000
# Interface d'écoute de l'API (127.0.0.1 par défaut : non exposée sur le réseau local).
# HOST=127.0.0.1
# Origines autorisées par CORS (séparées par des virgules).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base des URI de métadonnées inscrites dans NFTokenMint (vide -> http://localhost:3000).
# Le dépôt GitHub est PUBLIC : les métadonnées committées (metadata/evt-1/A-001..A-060.json) sont lisibles par tous.
# (Dépôt privé ou fork non poussé -> laisser vide : URI lisible seulement sur la machine de démo.)
# Dans tous les cas, l'intégrité est garantie par le sha256 du fichier inscrit dans le Memo ledgerpass/mint.
PUBLIC_BASE_URL=https://raw.githubusercontent.com/ninoatns/LedgerPass/main
